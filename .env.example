# Web
NEXT_PUBLIC_API_URL=http://localhost:8000
# Backend
DATABASE_URL=mysql+pymysql://ootd:ootd@localhost:3306/ootd?charset=utf8mb4
MYSQL_PORT=3306
STORAGE_BACKEND=local
STORAGE_BUCKET=ootd-private
# Cloudflare R2 / S3-compatible storage. Set STORAGE_BACKEND=r2 to enable direct cloud uploads.
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=auto
STORAGE_UPLOAD_URL_TTL_SECONDS=300
STORAGE_PENDING_TTL_SECONDS=3600
STORAGE_RECONCILE_INTERVAL_SECONDS=900
STORAGE_READ_URL_TTL_SECONDS=600
STORAGE_DELETE_GRACE_SECONDS=604800
REDIS_URL=redis://localhost:6379/0
PREFERENCE_CACHE_TTL_SECONDS=1800
STYLING_SESSION_TTL_SECONDS=7200
LANGGRAPH_CHECKPOINT_URL=mysql://ootd:ootd@localhost:3306/ootd_checkpoints?charset=utf8mb4
# LLM —— 任意 OpenAI 兼容接口（三选一）：
#   DeepSeek:  OPENAI_BASE_URL=https://api.deepseek.com/v1            OPENAI_MODEL=deepseek-chat
#   GLM 智谱:  OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4   OPENAI_MODEL=glm-4-flash
#   OpenAI:    OPENAI_BASE_URL=https://api.openai.com/v1               OPENAI_MODEL=gpt-4o
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-terra
# 衣物识别使用智谱视觉模型，与上面的通用模型凭据相互独立
OPENAI_VISION_MODEL=glm-5v-turbo
OPENAI_VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
OPENAI_VISION_API_KEY=
# 图片生成使用独立模型；GLM-5V-Turbo 仅输出文本，不能替代生图模型
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1024x1536
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ENVIRONMENT=development
# 仅供本地体验；生产环境无论此值如何都不会写入演示用户或衣橱。
SEED_DEMO_DATA=true
# 本地 API 用于签发访问令牌；生产环境必须改成高强度随机值。
AUTH_SHARED_SECRET=change-this-to-a-long-random-secret
# Open-Meteo 无需 API Key。Outlook 需要在 Microsoft Entra 注册 Web 应用，
# 并把下面的回调地址同时添加到该应用的 Redirect URIs。
FRONTEND_URL=http://localhost:3000
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/v1/integrations/outlook/callback
