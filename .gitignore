# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.pytest_cache/
/pytest-cache-files-*/
**/__pycache__/
*.py[cod]
/backend/*.db
/backend/*.sqlite3
/*.db
/backend/backups/

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
/outputs/
/work/

# local runtime artifacts
/backend/generated/

# Datasets, test media, and documentation excluded from the public repository
/tests/assets/
/tests/fixtures/
/tests/evals/*.jsonl
/docs/
*.md
!README.md

# Local agent metadata
/.agents/
/.codex/
